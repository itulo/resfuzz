# local/snippets/data_files.custom (generated by scripts/qnx-up.sh from data_files.custom.in)
# Bakes the resfuzz binaries into the data partition (/data), so a freshly
# built image can fuzz without scp (TODO-QNX I5). mkqnx6fsimg buildfile syntax:
# [attributes] target-path-relative-to-/data=host-path
[uid=0 gid=0 dperms=755 perms=755] resfuzz/resfuzz-agent=@BUILD@/resfuzz-agent
[uid=0 gid=0 dperms=755 perms=755] resfuzz/buggy_rm=@BUILD@/buggy_rm
[uid=0 gid=0 dperms=755 perms=755] resfuzz/buggy_rm_blind=@BUILD@/buggy_rm_blind
[uid=0 gid=0 dperms=755 perms=644] resfuzz/buggy_rm.qnx.dict=@REPO@/target/examples/buggy_rm.qnx.dict
